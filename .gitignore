# Dependencies. Both spellings on purpose: `node_modules/` matches a directory
# and NOT a symlink to one, which a worktree borrowing an install creates.
node_modules
node_modules/

# Build output
dist/
*.tsbuildinfo

# Test coverage
coverage/

# Logs
*.log
npm-debug.log*

# Environment files
.env
*.env
!*.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Package files
*.tgz
*.tar.gz

# Temporary files
tmp/
temp/

# Test destinations (may contain sensitive data)
test-destinations/*.json
test-destinations/*.env

# Test configuration (contains real credentials). The first line is where it
# lived before the workspace layout, kept so an old copy never shows up as new.
tests/test-config.yaml
packages/auth-broker/tests/test-config.yaml

*.json
!package.json
!package-lock.json
!tsconfig*.json
!biome.json

# Allow JSON for local test tooling
!packages/auth-broker/tests/stand/keycloak/*.json
!packages/auth-broker/tests/live/x509/xs-security.json

# The x509 live check's local state: the trial's x509 service key, its PEM
# certificate and private key, and the ledger of what setup.sh created.
packages/auth-broker/tests/live/x509/.local/

# Git worktrees
.worktrees/

# Superpowers scratch (ledger, briefs, review packages)
.superpowers/
