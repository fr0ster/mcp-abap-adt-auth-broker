# Dependencies. Both spellings on purpose: `node_modules/` matches a directory
# and NOT a symlink to one, which a worktree borrowing an install creates.
node_modules
node_modules/

# Build output
dist/
*.tsbuildinfo

# Test coverage
coverage/

# Logs
*.log
npm-debug.log*

# Environment files
.env
*.env
!*.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Package files
*.tgz
*.tar.gz

# Temporary files
tmp/
temp/

# Test destinations (may contain sensitive data)
test-destinations/*.json
test-destinations/*.env

# Test configuration (contains real credentials). The first line is where it
# lived before the workspace layout, kept so an old copy never shows up as new.
tests/test-config.yaml
packages/auth-broker/tests/test-config.yaml

*.json
!package.json
!package-lock.json
!tsconfig*.json
!biome.json

# Allow JSON for local test tooling
!packages/auth-broker-cli/tests/keycloak/*.json
!packages/auth-broker-cli/tests/sso-demo/**/*.json

# CAP demo build artifacts
packages/auth-broker-cli/tests/sso-demo/node_modules/
packages/auth-broker-cli/tests/sso-demo/gen/
packages/auth-broker-cli/tests/sso-demo/mta_archives/
packages/auth-broker-cli/tests/sso-demo/.cds-gen/
packages/auth-broker-cli/tests/sso-demo/.cds-services.json
packages/auth-broker-cli/tests/sso-demo/*.sqlite
packages/auth-broker-cli/tests/sso-demo/*.db
packages/auth-broker-cli/tests/sso-demo/.env
packages/auth-broker-cli/tests/sso-demo/*.xsuaa.json
packages/auth-broker-cli/tests/sso-demo/sso-demo-key.json
packages/auth-broker-cli/tests/sso-demo/*.xml

# Git worktrees
.worktrees/

# Superpowers scratch (ledger, briefs, review packages)
.superpowers/
