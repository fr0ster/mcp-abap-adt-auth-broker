{
  "name": "@mcp-abap-adt/auth-broker-cli",
  "version": "3.0.0",
  "description": "The mcp-auth command: log in to a SAP BTP or ABAP destination and write it — its means and the secret the login obtained — through @mcp-abap-adt/auth-broker",
  "bin": {
    "mcp-auth": "./dist/mcp-auth.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "COPYING"
  ],
  "keywords": [
    "abap",
    "sap",
    "adt",
    "jwt",
    "authentication",
    "cli",
    "mcp",
    "abap-adt",
    "xsuaa",
    "oauth2",
    "oidc",
    "saml",
    "sso"
  ],
  "author": "Oleksii Kyslytsia <oleksij.kyslytsja@gmail.com>",
  "license": "LGPL-3.0-only",
  "homepage": "https://github.com/fr0ster/mcp-abap-adt-auth-broker/tree/main/packages/auth-broker-cli#readme",
  "bugs": {
    "url": "https://github.com/fr0ster/mcp-abap-adt-auth-broker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fr0ster/mcp-abap-adt-auth-broker.git",
    "directory": "packages/auth-broker-cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"for (const p of ['dist', 'tsconfig.tsbuildinfo', 'tsconfig.build.tsbuildinfo']) require('fs').rmSync(p, { recursive: true, force: true })\"",
    "build": "tsc -b tsconfig.build.json",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:check": "tsc -p tsconfig.json --noEmit",
    "generate-env": "tsx src/generate-env-from-service-key.ts",
    "prepublishOnly": "npm run --prefix ../.. check"
  },
  "engines": {
    "node": "^22 || ^24 || ^26"
  },
  "dependencies": {
    "@mcp-abap-adt/auth-broker": "^5.0.0",
    "@mcp-abap-adt/auth-errors": "^2.1.1",
    "@mcp-abap-adt/auth-providers": "^6.0.0",
    "@mcp-abap-adt/auth-stores": "^4.0.0",
    "@mcp-abap-adt/interfaces-auth": "^7.5.0",
    "@mcp-abap-adt/interfaces-utils": "^1.1.0",
    "@mcp-abap-adt/logger": "^0.4.0"
  },
  "devDependencies": {
    "@mcp-abap-adt/auth-mocks": "^0.3.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0"
  }
}
