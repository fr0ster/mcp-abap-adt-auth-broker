{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    // packages/, not ./src: the type check covers the stand's shared test
    // helpers, ../auth-broker/tests/stand/*.ts, which the CLI's stand
    // suites import. The build compiles ./src alone (tsconfig.build.json).
    "rootDir": "..",
    "types": ["node", "jest"],
    // Where it would land by default moves with rootDir — into dist, which
    // is published; kept at the package root, where `clean` removes it.
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*", "../auth-broker/tests/stand/*.ts"],
  "exclude": ["node_modules", "dist"],
  "references": []
}
