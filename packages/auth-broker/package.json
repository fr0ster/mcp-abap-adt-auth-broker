    "@mcp-abap-adt/interfaces-utils": "^1.1.0"
  },
  "devDependencies": {
    "@mcp-abap-adt/auth-providers": "^4.2.0",
    "@mcp-abap-adt/auth-stores": "^1.2.3",
    "@mcp-abap-adt/logger": "^0.4.0",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.1",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3"
