{
  "name": "@mcp-abap-adt/auth-broker",
  "version": "3.0.4",
  "description": "Per-destination token broker for SAP BTP and ABAP: sessions and service keys from stores, tokens from an injected provider, results persisted",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "COPYING"
  ],
  "keywords": [
    "abap",
    "sap",
    "adt",
    "jwt",
    "authentication",
    "token",
    "broker",
    "mcp",
    "abap-adt",
    "xsuaa",
    "oauth2",
    "saml"
  ],
  "author": "Oleksii Kyslytsia <oleksij.kyslytsja@gmail.com>",
  "license": "LGPL-3.0-only",
  "homepage": "https://github.com/fr0ster/mcp-abap-adt-auth-broker/tree/main/packages/auth-broker#readme",
  "bugs": {
    "url": "https://github.com/fr0ster/mcp-abap-adt-auth-broker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fr0ster/mcp-abap-adt-auth-broker.git",
    "directory": "packages/auth-broker"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "build": "tsc -b tsconfig.build.json",
