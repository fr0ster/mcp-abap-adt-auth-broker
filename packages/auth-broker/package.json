{
  "name": "@mcp-abap-adt/auth-broker",
  "version": "5.0.0",
  "description": "Per-destination credential broker for SAP BTP and ABAP: the IAuthProvider a destination states, built from its key store and session store, with every secret it obtains stored back; and a token API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "COPYING"
  ],
  "keywords": [
    "abap",
    "sap",
    "adt",
    "jwt",
    "authentication",
    "token",
    "broker",
    "mcp",
    "abap-adt",
    "xsuaa",
    "oauth2",
    "saml"
  ],
  "author": "Oleksii Kyslytsia <oleksij.kyslytsja@gmail.com>",
  "license": "LGPL-3.0-only",
  "homepage": "https://github.com/fr0ster/mcp-abap-adt-auth-broker/tree/main/packages/auth-broker#readme",
  "bugs": {
    "url": "https://github.com/fr0ster/mcp-abap-adt-auth-broker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fr0ster/mcp-abap-adt-auth-broker.git",
    "directory": "packages/auth-broker"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"for (const p of ['dist', 'tsconfig.tsbuildinfo', 'tsconfig.build.tsbuildinfo']) require('fs').rmSync(p, { recursive: true, force: true })\"",
    "build": "tsc -b tsconfig.build.json",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:live": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -c jest.live.config.js",
    "test:live:x509": "tests/live/x509/run.sh",
    "test:stand": "tests/stand/run.sh",
    "stand:up": "tests/stand/up.sh",
    "stand:down": "tests/stand/down.sh",
    "test:check": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run --prefix ../.. check"
  },
  "engines": {
    "node": "^22 || ^24 || ^26"
  },
  "dependencies": {
    "@mcp-abap-adt/auth-errors": "^2.1.1",
    "@mcp-abap-adt/auth-providers": "^6.0.0",
    "@mcp-abap-adt/interfaces-auth": "^7.5.0",
    "@mcp-abap-adt/interfaces-auth-broker": "^1.3.0",
    "@mcp-abap-adt/interfaces-auth-sap": "^3.3.0",
    "@mcp-abap-adt/interfaces-utils": "^1.1.0"
  },
  "devDependencies": {
    "@mcp-abap-adt/auth-mocks": "^0.3.0",
    "@mcp-abap-adt/auth-stores": "^4.0.0",
    "@mcp-abap-adt/connection": "^14.0.0",
    "@mcp-abap-adt/logger": "^0.4.0",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.1",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3"
  }
}
